{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release ${version} [skip ci]",
    "tagName": "${version}",
    "tagAnnotation": "Release ${version}",
    "tagPrefix": "",
    "requireBranch": "main",
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": true,
    "releaseName": "Release ${version}"
  },
  "increment": "conventional",
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [],
    "after:bump": [],
    "after:release": []
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "tagPrefix": "",
        "types": [
          {
            "type": "feat",
            "section": "✨ Features"
          },
          {
            "type": "fix",
            "section": "🐛 Bug Fixes"
          },
          {
            "type": "perf",
            "section": "⚡ Performance"
          },
          {
            "type": "docs",
            "section": "📚 Documentation"
          },
          {
            "type": "refactor",
            "section": "♻️ Refactoring"
          },
          {
            "type": "test",
            "section": "✅ Tests"
          },
          {
            "type": "chore",
            "hidden": true
          },
          {
            "type": "style",
            "hidden": true
          }
        ]
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "ignoreRecommendedBump": false
    }
  }
}
